# Dependencies
node_modules/
.pnpm-store/
.pnpm/

# Build output
dist/
out/
build/
.next/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
apps/desktop/out/
apps/desktop/resources/bin/current/
apps/desktop/resources/bin/linux/
apps/desktop/resources/bin/mac/
apps/desktop/resources/bin/win/*.exe
apps/desktop/resources/bin/win/*.pdb
# Browser-store packages generated by scripts/build-extension.mjs.
apps/extension/dist/
# Legacy generated/self-hosting artifacts; retained locally only and never committed.
apps/desktop/resources/extension/
apps/extension/keys/
apps/extension/release/

# Android (widget/companion app)
apps/android/local.properties
apps/android/.gradle/
apps/android/**/.cxx/

# Rust
native/windows/target/
native/linux/target/
native/macos/target/
native/common/target/

# Env (machine-local secrets/overrides)
.credentials
local-credentials/
.env.local
.env.*.local
apps/web/.env
.vercel/
# Downloaded Google OAuth clients (the directory documentation remains tracked).
oauth/*.json

# Supabase CLI link state (project ref, pooler URL, service versions)
apps/web/supabase/.temp/

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
*:Zone.Identifier
.idea/
.vscode/

# Wine's NUL-device emulation drops a literal file named NUL in cwd when
# signtool.exe runs under Wine during cross-signed Windows builds (see
# scripts/lib/windows-release.mjs) — Windows reserves this name and it
# breaks checkout/clone there, so never let it get committed.
/NUL

# Emacs backup, autosave, lock, and temporary checker files
*~
\#*\#
.\#*
auto-save-list/
.emacs.desktop.lock
flycheck_*.el
*_flymake.*

# Vim swap, backup, undo, and netrw state files
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
[._]*.un~
.netrwhist

# LibreOffice lock and optional backup-copy files
.~lock.*#
~$*
*.[Bb][Aa][Kk]

# Claude Code machine-local permissions and command history
.claude/settings.local.json

# Recovery codes must never be committed
recovery-code.txt
apps/web/comp_codes_*.txt

# Marketing outreach drafts (not for version control)
marketing/emails/
.env.vercel
.vercel
