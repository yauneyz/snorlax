{
  "manifest_version": 3,
  "name": "Talysman",
  "version": "0.6.1",
  "description": "Companion for Talysman desktop that applies your configured website-blocking rules in the browser.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://redd.it/*",
        "*://*.redd.it/*",
        "*://news.ycombinator.com/*",
        "*://*.news.ycombinator.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://linkedin.com/*",
        "*://*.linkedin.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://theverge.com/*",
        "*://*.theverge.com/*",
        "*://theringer.com/*",
        "*://*.theringer.com/*",
        "*://substack.com/*",
        "*://*.substack.com/*"
      ],
      "js": [
        "site-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "premade-1",
        "enabled": false,
        "path": "premade-lists/premade.1.json"
      },
      {
        "id": "premade-2",
        "enabled": false,
        "path": "premade-lists/premade.2.json"
      },
      {
        "id": "premade-3",
        "enabled": false,
        "path": "premade-lists/premade.3.json"
      },
      {
        "id": "premade-4",
        "enabled": false,
        "path": "premade-lists/premade.4.json"
      },
      {
        "id": "premade-5",
        "enabled": false,
        "path": "premade-lists/premade.5.json"
      }
    ]
  },
  "action": {
    "default_title": "Talysman status",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {}
}
