{
  "manifest_version": 3,
  "name": "Talysman",
  "version": "0.6.0",
  "description": "Companion for Talysman desktop that applies your configured website-blocking rules in the browser.",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "premade-1",
        "enabled": false,
        "path": "premade-lists/premade.1.json"
      },
      {
        "id": "premade-2",
        "enabled": false,
        "path": "premade-lists/premade.2.json"
      },
      {
        "id": "premade-3",
        "enabled": false,
        "path": "premade-lists/premade.3.json"
      },
      {
        "id": "premade-4",
        "enabled": false,
        "path": "premade-lists/premade.4.json"
      },
      {
        "id": "premade-5",
        "enabled": false,
        "path": "premade-lists/premade.5.json"
      }
    ]
  },
  "action": {
    "default_title": "Talysman status",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {}
}
