# Copy to local.properties (gitignored) and fill in real values.
sdk.dir=/path/to/Android/Sdk

# Base URL of the deployed web app; /api/analytics/summary is appended by the client.
insights.baseUrl=https://www.talysman.app
# Same value as [insights].widget_api_key in the repo's .credentials.
insights.apiKey=

# Optional fallback Firebase Android app settings. The normal build reads these public client
# identifiers from local-credentials/talysman-insights-google-services.json instead.
fcm.projectId=
fcm.applicationId=
fcm.apiKey=
fcm.senderId=
